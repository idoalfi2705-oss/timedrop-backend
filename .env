# ===========================
# TimeDrop Backend – הגדרות
# ===========================

# שרת
PORT=5000
NODE_ENV=development

# JWT – שנה למחרוזת אקראית ארוכה!
JWT_SECRET=timedrop_secret_change_this_in_production_2026
JWT_EXPIRES_IN=7d

# מסד נתונים PostgreSQL
# התקן PostgreSQL מ: https://www.postgresql.org/download/windows/
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/timedrop"

# ========================================
# פריוריטי ERP – מלא כשיש לך גישה
# ========================================
PRIORITY_BASE_URL=https://your-company.priority-erpcloud.com
PRIORITY_USERNAME=your_priority_username
PRIORITY_PASSWORD=your_priority_password
PRIORITY_COMPANY=your_company_code

# Frontend URL (לCORS)
CLIENT_URL=http://localhost:3000
